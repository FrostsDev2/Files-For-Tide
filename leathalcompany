<!DOCTYPE html>
<html lang="en-us">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">

  <title>Lethal Company Web</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #050505;
      font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    #unity-container {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background:
        radial-gradient(
          circle at 50% 45%,
          rgba(80, 80, 70, 0.08),
          transparent 45%
        ),
        #050505;
    }

    #unity-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      background: #231f20;
      outline: none;
    }

    /* ------------------------------
       LOADING SCREEN
    ------------------------------ */

    #loading-screen {
      position: absolute;
      inset: 0;
      z-index: 20;

      display: flex;
      align-items: center;
      justify-content: center;

      background:
        radial-gradient(
          ellipse at center,
          rgba(50, 50, 45, 0.12) 0%,
          rgba(5, 5, 5, 0.95) 70%
        ),
        #050505;

      transition:
        opacity 0.5s ease,
        visibility 0.5s ease;
    }

    #loading-screen.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    /* subtle scanlines */
    #loading-screen::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;

      background:
        repeating-linear-gradient(
          to bottom,
          rgba(255,255,255,0.018) 0px,
          rgba(255,255,255,0.018) 1px,
          transparent 1px,
          transparent 4px
        );

      opacity: 0.35;
    }

    /* subtle vignette */
    #loading-screen::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;

      background:
        radial-gradient(
          ellipse at center,
          transparent 35%,
          rgba(0,0,0,0.75) 100%
        );
    }

    .loading-content {
      position: relative;
      z-index: 2;

      width: min(440px, calc(100vw - 48px));

      display: flex;
      flex-direction: column;
      align-items: center;

      color: #e8e8e8;
    }

    /* ------------------------------
       LOGO
    ------------------------------ */

    .game-logo {
      text-align: center;
      margin-bottom: 42px;

      animation: logoFade 0.8s ease forwards;
    }

    .game-logo .small {
      display: block;

      margin-bottom: 7px;

      color: #888;

      font-size: 10px;
      font-weight: 600;
      letter-spacing: 5px;
      text-transform: uppercase;
    }

    .game-logo .title {
      display: block;

      color: #f1f1f1;

      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(30px, 6vw, 46px);
      font-weight: 700;
      letter-spacing: -1px;
      line-height: 1;
    }

    .game-logo .subtitle {
      display: block;

      margin-top: 9px;

      color: #666;

      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    /* ------------------------------
       LOADING INFO
    ------------------------------ */

    .loading-info {
      width: 100%;
    }

    .loading-top {
      display: flex;
      justify-content: space-between;
      align-items: center;

      margin-bottom: 10px;

      color: #777;

      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    #unity-status-text {
      color: #aaa;
    }

    #loading-percent {
      color: #777;
      font-variant-numeric: tabular-nums;
    }

    /* progress track */
    #unity-progress-bar-empty {
      position: relative;

      width: 100%;
      height: 3px;

      overflow: hidden;

      background: #202020;
    }

    #unity-progress-bar-full {
      width: 0%;
      height: 100%;

      background: #d8d8d8;

      transition: width 0.2s ease;
      box-shadow: 0 0 10px rgba(255,255,255,0.15);
    }

    .loading-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;

      margin-top: 13px;

      color: #444;

      font-size: 9px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }

    .loading-bottom-left {
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .status-dot {
      width: 5px;
      height: 5px;

      border-radius: 50%;

      background: #aaa;

      box-shadow: 0 0 8px rgba(255,255,255,0.25);

      animation: pulse 1.4s ease-in-out infinite;
    }

    /* ------------------------------
       WARNING / ERROR
    ------------------------------ */

    #unity-warning {
      position: absolute;
      z-index: 50;

      left: 50%;
      top: 28px;

      transform: translateX(-50%);

      width: min(600px, calc(100vw - 32px));

      display: none;

      overflow: hidden;

      background: rgba(12, 12, 12, 0.96);
      border: 1px solid #333;

      color: #ddd;

      font-size: 12px;
      line-height: 1.5;

      box-shadow: 0 15px 50px rgba(0,0,0,0.5);
    }

    .warning-content {
      padding: 13px 15px;
    }

    .warning-error {
      border-color: #5a3030;
    }

    /* ------------------------------
       ANIMATIONS
    ------------------------------ */

    @keyframes logoFade {
      from {
        opacity: 0;
        transform: translateY(8px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes pulse {
      0%,
      100% {
        opacity: 0.35;
        transform: scale(0.8);
      }

      50% {
        opacity: 1;
        transform: scale(1);
      }
    }

    /* ------------------------------
       MOBILE
    ------------------------------ */

    @media (max-width: 600px) {
      .game-logo {
        margin-bottom: 32px;
      }

      .game-logo .title {
        font-size: 34px;
      }

      .loading-content {
        width: calc(100vw - 40px);
      }
    }
  </style>
</head>

<body>

  <div id="unity-container">

    <canvas id="unity-canvas" tabindex="-1"></canvas>

    <!-- Loading UI -->
    <div id="loading-screen">

      <div class="loading-content">

        <div class="game-logo">
          <span class="small">ZeekerssRBLX presents</span>
          <span class="title">Lethal Company</span>
          <span class="subtitle">Web Edition</span>
        </div>

        <div class="loading-info">

          <div class="loading-top">
            <span id="unity-status-text">Initializing...</span>
            <span id="loading-percent">0%</span>
          </div>

          <div id="unity-progress-bar-empty">
            <div id="unity-progress-bar-full"></div>
          </div>

          <div class="loading-bottom">
            <div class="loading-bottom-left">
              <span class="status-dot"></span>
              <span>System Online</span>
            </div>

            <span>v0.1</span>
          </div>

        </div>

      </div>

    </div>

    <div id="unity-warning"></div>

  </div>

  <script>
    window.WispRelayWSState = {
      sock: null,
      recvPtr: 0,
      sid: 0
    };
  </script>

  <script>
    var container = document.querySelector("#unity-container");
    var canvas = document.querySelector("#unity-canvas");

    var loadingScreen = document.querySelector("#loading-screen");
    var progressBarFull = document.querySelector("#unity-progress-bar-full");
    var statusText = document.querySelector("#unity-status-text");
    var loadingPercent = document.querySelector("#loading-percent");
    var warningBanner = document.querySelector("#unity-warning");


    /* --------------------------------
       UNITY BANNER
    -------------------------------- */

    function unityShowBanner(msg, type) {

      warningBanner.innerHTML = "";

      var div = document.createElement("div");
      div.className = "warning-content";
      div.textContent = msg;

      warningBanner.appendChild(div);

      warningBanner.className =
        type === "error"
          ? "warning-error"
          : "";

      warningBanner.style.display = "block";

      if (type !== "error") {
        setTimeout(function () {
          warningBanner.style.display = "none";
        }, 5000);
      }
    }


    /* --------------------------------
       GITHUB / JSDELIVR
    -------------------------------- */

    var GH_USER = "larpinguser";
    var GH_REPO = "lethal";
    var GH_BRANCH = "main";
    var GH_PATH = "build/Build";

    var JSDELIVR_BASE =
      "https://cdn.jsdelivr.net/gh/" +
      GH_USER +
      "/" +
      GH_REPO +
      "@" +
      GH_BRANCH +
      "/" +
      GH_PATH;


    /* --------------------------------
       SPLIT FILE CONFIG
    -------------------------------- */

    var DATA_PART_COUNT = 18;
    var WASM_PART_COUNT = 5;


    function padded(n) {
      return n < 10 ? "0" + n : "" + n;
    }


    var dataPartUrls = [];

    for (var i = 1; i <= DATA_PART_COUNT; i++) {

      dataPartUrls.push(
        JSDELIVR_BASE +
        "/build.data.part" +
        padded(i)
      );

    }


    var wasmPartUrls = [];

    for (var j = 1; j <= WASM_PART_COUNT; j++) {

      wasmPartUrls.push(
        JSDELIVR_BASE +
        "/build.wasm.part" +
        j
      );

    }


    var frameworkUrl =
      JSDELIVR_BASE +
      "/build.framework.js";

    var loaderUrl =
      JSDELIVR_BASE +
      "/build.loader.js";

    var streamingAssetsUrl =
      JSDELIVR_BASE.replace(/\/Build$/, "") +
      "/StreamingAssets";


    /* --------------------------------
       UNITY CONFIG
    -------------------------------- */

    var config = {

      dataUrl: null,

      frameworkUrl: frameworkUrl,

      codeUrl: null,

      streamingAssetsUrl: streamingAssetsUrl,

      companyName: "ZeekerssRBLX",

      productName: "Lethal Company",

      productVersion: "0.1",

      showBanner: unityShowBanner,

      webglContextAttributes: {

        antialias: false,

        preserveDrawingBuffer: true,

        powerPreference: "high-performance",

        failIfMajorPerformanceCaveat: false

      }

    };


    /* --------------------------------
       MOBILE
    -------------------------------- */

    if (/iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {

      var meta = document.createElement("meta");

      meta.name = "viewport";

      meta.content =
        "width=device-width, height=device-height, " +
        "initial-scale=1.0, user-scalable=no, " +
        "shrink-to-fit=yes";

      document
        .getElementsByTagName("head")[0]
        .appendChild(meta);

      container.className = "unity-mobile";

      canvas.className = "unity-mobile";
    }


    /* --------------------------------
       PROGRESS
    -------------------------------- */

    function setProgress(percent, message) {

      percent = Math.max(0, Math.min(100, percent));

      progressBarFull.style.width =
        percent + "%";

      loadingPercent.textContent =
        Math.round(percent) + "%";

      if (message) {
        statusText.textContent = message;
      }
    }


    /* --------------------------------
       DOWNLOAD
    -------------------------------- */

    async function fetchPart(url) {

      var res = await fetch(url);

      if (!res.ok) {

        throw new Error(
          "Failed to fetch " +
          url +
          " (HTTP " +
          res.status +
          ")"
        );

      }

      return res.arrayBuffer();
    }


    async function reassemble(urls, onEachDone) {

      var buffers = [];

      for (var k = 0; k < urls.length; k++) {

        buffers.push(
          await fetchPart(urls[k])
        );

        onEachDone();
      }

      return new Blob(buffers);
    }


    /* --------------------------------
       LOAD UNITY LOADER
    -------------------------------- */

    function loadScript(src) {

      return new Promise(function(resolve, reject) {

        var s = document.createElement("script");

        s.src = src;

        s.onload = resolve;

        s.onerror = function() {

          reject(
            new Error(
              "Failed to load Unity loader"
            )
          );

        };

        document.body.appendChild(s);

      });

    }


    /* --------------------------------
       START
    -------------------------------- */

    (async function main() {

      try {

        var totalParts =
          dataPartUrls.length +
          wasmPartUrls.length;

        var partsDone = 0;


        function bumpDownloadProgress() {

          partsDone++;

          var pct =
            (partsDone / totalParts) * 80;

          setProgress(
            pct,
            "Downloading game files"
          );

          statusText.textContent =
            "Downloading game files " +
            "(" +
            partsDone +
            "/" +
            totalParts +
            ")";

        }


        setProgress(
          0,
          "Preparing game files"
        );


        /* DATA */

        statusText.textContent =
          "Downloading game data";

        var dataBlob =
          await reassemble(
            dataPartUrls,
            bumpDownloadProgress
          );


        /* WASM */

        statusText.textContent =
          "Downloading game engine";

        var wasmBlob =
          await reassemble(
            wasmPartUrls,
            bumpDownloadProgress
          );


        /* OBJECT URLS */

        config.dataUrl =
          URL.createObjectURL(dataBlob);

        config.codeUrl =
          URL.createObjectURL(wasmBlob);


        /* UNITY LOADER */

        setProgress(
          82,
          "Starting Unity engine"
        );

        await loadScript(loaderUrl);


        /* UNITY INSTANCE */

        statusText.textContent =
          "Loading engine";


        var unityInstance =
          await createUnityInstance(
            canvas,
            config,
            function(progress) {

              var pct =
                80 +
                progress * 20;

              setProgress(
                pct,
                "Loading engine"
              );

            }
          );


        /* FINISHED */

        setProgress(
          100,
          "Ready"
        );

        setTimeout(function() {

          loadingScreen.classList.add(
            "hidden"
          );

          canvas.focus();

        }, 300);


      } catch (err) {

        console.error(err);

        statusText.textContent =
          "Failed to load";

        unityShowBanner(
          err.message || String(err),
          "error"
        );

      }

    })();
  </script>

</body>
</html>
